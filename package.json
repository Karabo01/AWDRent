{
  "name": "awdrent",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @awdrent/web",
    "dev:worker": "npm run dev -w @awdrent/worker",
    "build": "npm run build -w @awdrent/web && npm run build -w @awdrent/worker",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "npm run generate -w @awdrent/db",
    "db:migrate": "npm run migrate -w @awdrent/db",
    "db:seed": "npm run seed -w @awdrent/core",
    "platform:create-admin": "npm run create-platform-admin -w @awdrent/db --",
    "storage:init": "npm run ensure-bucket -w @awdrent/core"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.37.0",
    "otpauth": "^9.5.2",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  }
}
