{
  "name": "@awdrent/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "seed": "tsx --env-file-if-exists=../../.env scripts/seed.ts",
    "ensure-bucket": "tsx --env-file-if-exists=../../.env scripts/ensure-bucket.ts"
  },
  "dependencies": {
    "@awdrent/config": "*",
    "@awdrent/db": "*",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@react-pdf/renderer": "^4.9.0",
    "bullmq": "^5.81.5",
    "csv-parse": "^7.0.3",
    "react": "^19.3.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0"
  }
}
