# ─── AWDRent environment ───────────────────────────────────────────────
# Copy to .env for local development. In Coolify, set these on the
# resource's Environment Variables tab. Every value is validated at
# startup by packages/config; the app refuses to start if one is wrong.

NODE_ENV=development

# Routing. Agencies are served at {subdomain}.APP_BASE_DOMAIN and the
# platform console at admin.APP_BASE_DOMAIN.
# Local: localhost (browsers resolve *.localhost to 127.0.0.1)
# Production: awdrent.co.za
APP_BASE_DOMAIN=localhost
APP_PROTOCOL=http
# Port used in generated links. Leave empty in production.
APP_PUBLIC_PORT=3000

# ─── Postgres ──────────────────────────────────────────────────────────
# Superuser, used only by the postgres container to create the database
# and roles on first start (docker/postgres/init).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=awdrent

# Passwords for the four application roles.
#   awdrent_owner    owns the tables; runs migrations and seed. Never used by the app.
#   awdrent_app      the web app and worker; cannot bypass row-level security
#   awdrent_auth     staff/platform login tables only
#   awdrent_platform agencies and platform tables only (platform console)
DB_OWNER_PASSWORD=change-me-owner
DB_APP_PASSWORD=change-me-app
DB_AUTH_PASSWORD=change-me-auth
DB_PLATFORM_PASSWORD=change-me-platform

# Inside docker-compose the host is "postgres"; from your machine it is localhost.
DATABASE_URL=postgres://awdrent_app:change-me-app@localhost:5432/awdrent
DATABASE_AUTH_URL=postgres://awdrent_auth:change-me-auth@localhost:5432/awdrent
DATABASE_PLATFORM_URL=postgres://awdrent_platform:change-me-platform@localhost:5432/awdrent
DATABASE_OWNER_URL=postgres://awdrent_owner:change-me-owner@localhost:5432/awdrent

# Integration tests use a separate database on the same server.
TEST_DATABASE_NAME=awdrent_test

# ─── Redis (BullMQ) ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Where login and one-time-code rate limits are counted. Must be redis in
# production (shared by all web containers). "memory" is only for running
# locally without Redis.
RATE_LIMIT_STORAGE=redis

# ─── Object storage (MinIO / any S3-compatible) ────────────────────────
MINIO_ROOT_USER=awdrent
MINIO_ROOT_PASSWORD=change-me-minio
S3_ENDPOINT=http://localhost:9000
# What the browser uses for signed links. Production: https://files.awdrent.co.za
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=af-south-1
S3_ACCESS_KEY_ID=awdrent
S3_SECRET_ACCESS_KEY=change-me-minio
S3_BUCKET=awdrent
S3_FORCE_PATH_STYLE=true

# ─── Virus scanning ────────────────────────────────────────────────────
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ─── Column encryption (ID numbers, bank account numbers) ──────────────
# Comma-separated version:base64 pairs; each key is 32 random bytes.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# To rotate: add a new version, set it active, run the re-encrypt job, then remove the old key.
# LOSING THESE KEYS MAKES THE ENCRYPTED DATA UNRECOVERABLE. Store them in your password manager.
ENCRYPTION_KEYS=1:REPLACE_WITH_32_BYTE_BASE64_KEY
ENCRYPTION_ACTIVE_KEY_VERSION=1
# Keyed hash for searching encrypted ID numbers. 32 bytes base64. Never rotate casually:
# changing it breaks lookups until every row is re-indexed.
BLIND_INDEX_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# ─── Auth ──────────────────────────────────────────────────────────────
# At least 32 random characters each, and different from each other.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
PLATFORM_AUTH_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET_32_CHARS

# ─── Email (Resend) ────────────────────────────────────────────────────
# Optional in Phase 1. Without a key, emails are written to the worker log.
RESEND_API_KEY=
EMAIL_FROM=AWDRent <no-reply@awdrent.co.za>
